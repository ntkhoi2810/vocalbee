# Copy to .env.local. Demo accounts are available only when enabled.
VOCALBEE_DEMO=true
# Required when VOCALBEE_DEMO is not true (at least 12 characters).
# VOCALBEE_ADMIN_PASSWORD=replace-with-your-own-password
# Durable SQLite directory; default: ./data
# VOCALBEE_DATA_DIR=./data
# Set true behind HTTPS. Leave false for local HTTP / school LAN.
VOCALBEE_SECURE_COOKIE=false
